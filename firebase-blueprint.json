{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile storing personal credentials, settings, and authorization role",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user ID matching Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Google account email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name from Google Auth"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Avatar photo URL from Google Auth"
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "Authorization level within NINJA"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of account initialization"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last profile synchronization"
        }
      },
      "required": ["id", "email", "role"]
    },
    "CommandHistory": {
      "title": "CommandHistory",
      "description": "Record of executed command or tool run",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique history item ID"
        },
        "userId": {
          "type": "string",
          "description": "Owning user UID"
        },
        "command": {
          "type": "string",
          "maxLength": 500,
          "description": "The command entered by the user"
        },
        "toolId": {
          "type": "string",
          "maxLength": 100,
          "description": "Target tool identifier"
        },
        "toolName": {
          "type": "string",
          "maxLength": 100,
          "description": "Human readable name of the tool"
        },
        "status": {
          "type": "string",
          "enum": ["success", "failed", "pending"],
          "description": "Execution status"
        },
        "resultPreview": {
          "type": "string",
          "maxLength": 2000,
          "description": "Summary output or snippet"
        },
        "timestamp": {
          "type": "string",
          "description": "Execution timestamp"
        }
      },
      "required": ["id", "userId", "command", "toolId", "toolName", "status"]
    },
    "SavedWorkflow": {
      "title": "SavedWorkflow",
      "description": "User saved multi-step automation workflow",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique workflow ID"
        },
        "userId": {
          "type": "string",
          "description": "Owning user UID"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Title of the workflow"
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Detailed explanation of workflow purpose"
        },
        "isTemplate": {
          "type": "boolean",
          "description": "Whether this is a public template"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last modification timestamp"
        }
      },
      "required": ["id", "userId", "name"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account document"
    },
    "/users/{userId}/history/{historyId}": {
      "schema": "CommandHistory",
      "description": "User personal command execution history"
    },
    "/users/{userId}/workflows/{workflowId}": {
      "schema": "SavedWorkflow",
      "description": "User custom automation workflows"
    }
  }
}
